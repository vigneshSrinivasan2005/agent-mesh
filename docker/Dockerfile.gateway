FROM python:3.11-slim

WORKDIR /app

# Install basic networking tools and dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY mesh_gateway/ /app/mesh_gateway/
COPY web_status/ /app/web_status/
COPY config.example.yaml /app/config.example.yaml

RUN pip install --no-cache-dir -e /app/mesh_gateway

EXPOSE 8000

ENV PYTHONUNBUFFERED=1

ENTRYPOINT ["agent-mesh", "run"]
CMD ["--config", "/app/config.example.yaml", "--host", "0.0.0.0", "--port", "8000"]
